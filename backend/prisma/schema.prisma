
// Schéma Prisma MAÎTRE — couvre TOUTES les tables (auth + site + bot).
// ⚠️ `prisma db push` / migrations uniquement depuis CE repo (upload.db-nds-shop.fr).
// Les repos db-nds-shop et NDS-Shop-Bot ne font que `prisma generate`
// avec des schémas partiels répliqués (jamais de db push chez eux).
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  role            String    @default("member")
  createdAt       DateTime  @default(now())
  name            String    @db.Text
  email           String
  emailVerified   Boolean   @default(false)
  image           String?   @db.Text
  updatedAt       DateTime  @updatedAt
  displayUsername String?   @db.Text
  banned          Boolean?  @default(false)
  banReason       String?   @db.Text
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @db.Text

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

// Demandes de jeux du site public (db-nds-shop) — 1 ligne par jeu demandé.
model GameRequest {
  id            String            @id @default(cuid())
  title         String
  systems       String?
  note          String?           @db.Text
  requesterId   String?
  requesterName String?
  createdAt     DateTime          @default(now())
  votes         GameRequestVote[]

  @@index([title])
  @@map("game_request")
}

model GameRequestVote {
  requestId String
  request   GameRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())

  @@id([requestId, userId])
  @@map("game_request_vote")
}

// --- Téléchargements (tracking BDD) ---
model DownloadLog {
  id        String   @id @default(cuid())
  game      String   // nom du fichier (ex: "Kirby.nds")
  title     String?  // titre du jeu (pour les stats)
  userAgent String?  // "NDS-Shop-v1.0.0"
  ip        String?  // IP anonymisée (optionnel)
  createdAt DateTime @default(now())

  @@index([game])
  @@index([createdAt])
  @@map("DownloadLog")
}

// ============================================================
// BOT DISCORD (NDS-Shop-Bot) — tables bot_*
// Le schéma du bot est une réplique generate-only ; c'est ICI la source de vérité.
// `prisma db push` uniquement depuis ce repo.
// ============================================================

model BotAnnouncement {
  id        String    @id @default(cuid())
  title     String    @db.Text
  content   String    @db.Text
  channel   String    @db.Text
  status    String    @default("draft")
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  sentBy    String?   @db.Text

  @@map("bot_announcement")
}

model BotSetting {
  key   String @id
  value String @db.Text

  @@map("bot_setting")
}

model BotLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("bot_log")
}

model BotTicket {
  id         String              @id @default(cuid())
  userId     String              @db.Text
  username   String?             @db.Text
  category   String              @db.Text
  threadId   String?             @db.Text
  status     String              @default("open")
  createdAt  DateTime            @default(now())
  closedAt   DateTime?
  messages   BotTicketMessage[]

  @@map("bot_ticket")
}

model BotTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    BotTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String   @db.Text
  author    String   @db.Text
  content   String   @db.Text
  direction String   @default("user")
  createdAt DateTime @default(now())

  @@map("bot_ticket_message")
}

model BotUserProfile {
  id           String    @id @default(cuid())
  discordId    String    @unique
  xp           BigInt    @default(0)
  level        Int       @default(1)
  favorites    String?   @db.Text
  watched      String?   @db.Text
  lastXpAt     DateTime?
  totalMsgs    Int       @default(0)
  badge        String?   @db.Text
  updatedAt    DateTime  @updatedAt

  @@map("bot_user_profile")
}

model BotGameSub {
  id        String @id @default(cuid())
  discordId String @unique
  games     String @db.Text

  @@map("bot_game_sub")
}

model BotReminder {
  id        String    @id @default(cuid())
  discordId String    @db.Text
  content   String    @db.Text
  channelId String?   @db.Text
  dueAt     DateTime
  sent      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@map("bot_reminder")
}

model BotCommandLog {
  id        String    @id @default(cuid())
  userId    String    @db.Text
  username  String?   @db.Text
  command   String    @db.Text
  options   String?   @db.Text
  createdAt DateTime  @default(now())

  @@map("bot_command_log")
}

model BotBlacklist {
  id        String    @id @default(cuid())
  discordId String    @unique
  reason    String?   @db.Text
  createdAt DateTime  @default(now())

  @@map("bot_blacklist")
}

model BotWarn {
  id        String    @id @default(cuid())
  discordId String    @db.Text
  modId     String?   @db.Text
  reason    String?   @db.Text
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("bot_warn")
}

model BotDmContact {
  id          String         @id @default(cuid())
  discordId   String         @unique
  username    String         @db.Text
  lastMessage String?        @db.Text
  lastAt      DateTime       @default(now())
  unreadCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    BotDmMessage[]

  @@map("bot_dm_contact")
}

model BotDmMessage {
  id        String       @id @default(cuid())
  contactId String
  contact   BotDmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction String       @default("user") // user | staff
  authorId  String       @db.Text
  author    String       @db.Text
  content   String       @db.Text
  createdAt DateTime     @default(now())

  @@map("bot_dm_message")
}

// Demandes de jeux issues du forum Discord (bot) — table distincte de game_request (site)
model BotGameRequest {
  id        String   @id @default(cuid())
  threadId  String   @unique @db.VarChar(32)
  discordId String   @db.VarChar(32)
  title     String   @db.Text
  tagId     String?  @db.VarChar(32)
  status    String   @default("Demandé")
  createdAt DateTime @default(now())

  @@map("bot_game_request")
}

model Game {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  titleId         String?
  version         String?
  author          String?
  developer       String?
  publisher       String?
  descriptionMd   String?  @db.Text
  systems         Json
  genres          Json
  categories      Json
  color           String?
  colorBg         String?
  priority        Boolean  @default(false)
  stars           Int      @default(0)
  iconUrl         String?
  imageUrl        String?
  boxartUrl       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  
  screenshots     GameScreenshot[]
  downloads       GameDownload[]
  scripts         GameScript[]

  @@map("game")
}

model GameScreenshot {
  id          String @id @default(cuid())
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  description String
  url         String
  order       Int
  @@map("game_screenshot")
}

model GameDownload {
  id        String @id @default(cuid())
  gameId    String
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  fileName  String
  url       String
  size      BigInt?
  type      String
  @@map("game_download")
}

model GameScript {
  id        String @id @default(cuid())
  gameId    String
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String
  script    Json
  @@map("game_script")
}
