
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  role            String    @default("member")
  createdAt       DateTime  @default(now())
  name            String    @db.Text
  email           String
  emailVerified   Boolean   @default(false)
  image           String?   @db.Text
  updatedAt       DateTime  @updatedAt
  displayUsername String?   @db.Text
  banned          Boolean?  @default(false)
  banReason       String?   @db.Text
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @db.Text

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

// Demandes de jeux du site public (db-nds-shop) — 1 ligne par jeu demandé.
model GameRequest {
  id            String            @id @default(cuid())
  title         String
  systems       String?
  note          String?           @db.Text
  requesterId   String?
  requesterName String?
  createdAt     DateTime          @default(now())
  votes         GameRequestVote[]

  @@index([title])
  @@map("game_request")
}

model GameRequestVote {
  requestId String
  request   GameRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())

  @@id([requestId, userId])
  @@map("game_request_vote")
}

// --- Téléchargements (tracking BDD) ---
model DownloadLog {
  id        String   @id @default(cuid())
  game      String   // nom du fichier (ex: "Kirby.nds")
  title     String?  // titre du jeu (pour les stats)
  userAgent String?  // "NDS-Shop-v1.0.0"
  ip        String?  // IP anonymisée (optionnel)
  createdAt DateTime @default(now())

  @@index([game])
  @@index([createdAt])
}
