# ==============================================================================
# upload.db-nds-shop.fr/backend - Variables d'environnement
# Copie ce fichier en .env dans backend/
# ==============================================================================

# Environnement
NODE_ENV=production

# Port du serveur
PORT=3002

# ------------- URLs -------------
# URL du site public
SITE_URL="https://db-nds-shop.fr"
# URL de ce frontend (upload)
FRONTEND_URL="https://upload.db-nds-shop.fr"
# URL d'accès à cette API (même chose que FRONTEND_URL)
BETTER_AUTH_URL="https://upload.db-nds-shop.fr"
# URL de l'API publique interne (Docker: http://api:3000)
API_INTERNAL_URL="http://api:3000"

# ------------- Better Auth -------------
# GÉNÉRER DIFFÉREMMENT du bot: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32_UNIQUE"

# ------------- DATABASE (MySQL) -------------
DATABASE_URL="mysql://ndsshop:CHANGE_ME_mdp@mysql:3306/ndsshop"

# ------------- Discord Bot (celui de l'upload) -------------
DISCORD_BOT_TOKEN="CHANGE_ME_token"
DISCORD_GUILD_ID="1271186486070345843"

# ------------- Storage (chemins DANS le container) -------------
STORAGE_PATH="/srv/nds-shop"
MEDIA_STORAGE_PATH="/srv/nds-shop/assets"
ICONS_PATH="/srv/nds-shop/assets/icons"
SCREENSHOTS_PATH="/srv/nds-shop/assets/screenshots"
BOXARTS_PATH="/srv/nds-shop/assets/boxarts"
# ROMs NDS
GAMES_PATH="/srv/nds-shop/roms/nds"
ROMS_PATH="/srv/nds-shop/roms"
